@startuml
!include <C4/C4_Context>
skinparam defaultFontName Arial
LAYOUT_WITH_LEGEND()

Person(user, "Пользователь", "Задаёт отслеживаемые товары и получает уведомления о выгодных объявлениях")
Person(admin, "Администратор", "Повышенный лимит товаров, отчёт о состоянии системы, оповещения о сбоях")

System(bot, "Система отслеживания цен", "Telegram-бот и серверный сервис: опрос площадки, отбор объявлений, очередь уведомлений")

System_Ext(tg, "Telegram Bot API", "Приём сообщений пользователей и доставка уведомлений")
System_Ext(kufar, "Kufar.by", "Поисковый интерфейс площадки объявлений")
SystemDb_Ext(db, "PostgreSQL", "Пользователи, товары, объявления, совпадения, журнал уведомлений, справочник фильтров")
System_Ext(mail, "Почтовый сервер (SMTP)", "Коды подтверждения, копии уведомлений, отчёты")

Rel(user, tg, "Команды и кнопки", "Telegram")
Rel(admin, tg, "Команды, отчёты", "Telegram")
Rel(tg, bot, "Обновления", "long polling")
Rel(bot, tg, "Ответы, уведомления, оповещения", "HTTPS")
Rel(bot, kufar, "Поиск объявлений каждые 3 мин, не более 30 запросов в минуту", "HTTPS, JSON")
Rel(bot, db, "Чтение и запись данных", "SQL")
Rel(bot, mail, "Письма", "SMTP")
@enduml
