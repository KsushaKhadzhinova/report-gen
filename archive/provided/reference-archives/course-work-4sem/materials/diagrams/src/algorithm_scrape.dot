digraph scrape {
  rankdir=TB; bgcolor="white"; splines=polyline; nodesep=0.55; ranksep=0.5;
  node [fontname="DejaVu Sans", fontsize=12, color="#333333", penwidth=1.2, style=filled, fillcolor=white];
  edge [fontname="DejaVu Sans", fontsize=11, color="#333333", penwidth=1.2, arrowhead=none];

  start  [shape=box, style="rounded,filled", label="Начало"];
  conn   [shape=circle, width=0.4, fixedsize=true, label="А"];
  sel    [shape=box, label="Выбрать активные\nотслеживаемые товары"];
  d1     [shape=diamond, height=1.2, width=2.8, label="Остались\nтовары?"];
  req    [shape=box, label="Сформировать запрос к площадке:\nкатегория, фильтры, пороговая цена"];
  get    [shape=parallelogram, width=3.4, label="Получить объявления"];
  d2     [shape=diamond, height=1.2, width=3.0, label="Площадка\nответила отказом?"];
  proc   [shape=box, label="Обработать полученные\nобъявления"];
  conn2  [shape=circle, width=0.4, fixedsize=true, label="А"];
  pause  [shape=box, label="Увеличить паузу,\nоповестить администратора"];
  stop2  [shape=box, style="rounded,filled", label="Конец"];
  commit [shape=box, label="Зафиксировать транзакцию"];
  stop   [shape=box, style="rounded,filled", label="Конец"];

  start -> sel -> d1;
  d1 -> req [label="да"];
  req -> get -> d2 -> proc;
  d2 -> proc [label="нет"];
  proc -> conn2;
  conn -> d1 [arrowhead=normal];
  d2 -> pause [label="да"];
  pause -> stop2;
  d1 -> commit [label="нет"];
  commit -> stop;

  { rank=same; conn; d1; commit; }
  { rank=same; d2; pause; }
  { rank=same; proc; stop2; }
  { rank=same; conn2; stop; }
}
