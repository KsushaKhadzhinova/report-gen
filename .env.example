# Провайдер моделей: cloud (по умолчанию), local или custom
REPORTGEN_PROVIDER=cloud

# Бесплатный ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Для провайдера custom (любой OpenAI-совместимый сервер, например прокси free-claude-code)
REPORTGEN_BASE_URL=
REPORTGEN_API_KEY=

# Каталог с проектами, который будет доступен программе по пути /code
REPORTGEN_CODE_DIR=./projects

# Каталог эталонных работ для проверки совпадений
# REPORTGEN_REFERENCE=workspace/reference
